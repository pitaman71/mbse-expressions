{
  "name": "@mbse/expressions",
  "version": "0.9.0",
  "description": "Constraints as language-neutral data: validated, evaluated, stored as JSON/YAML, and translated to and from Python, MATLAB and Excel (TypeScript implementation)",
  "keywords": [
    "expressions",
    "constraints",
    "predicates",
    "mbse",
    "sysml",
    "interface",
    "translation",
    "excel",
    "matlab"
  ],
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./Framework": "./src/Framework/index.ts",
    "./Patterns/Expressions": "./src/Patterns/Expressions/index.ts",
    "./Python/Python3": "./src/Python/Python3/index.ts",
    "./TypeScript/TypeScript5": "./src/TypeScript/TypeScript5/index.ts",
    "./C/Expressions": "./src/C/Expressions/index.ts",
    "./Cpp/Expressions": "./src/Cpp/Expressions/index.ts",
    "./SystemVerilog/Expressions": "./src/SystemVerilog/Expressions/index.ts",
    "./SystemVerilog/Types": "./src/SystemVerilog/Types/index.ts",
    "./SystemVerilog/Patterns": "./src/SystemVerilog/Patterns/index.ts",
    "./SystemVerilog/Assertions": "./src/SystemVerilog/Assertions/index.ts",
    "./SystemVerilog/Constraints": "./src/SystemVerilog/Constraints/index.ts",
    "./SystemVerilog/Preprocessor": "./src/SystemVerilog/Preprocessor/index.ts",
    "./SystemV/AMD64": "./src/SystemV/AMD64/index.ts",
    "./Arm/AAPCS64": "./src/Arm/AAPCS64/index.ts",
    "./MATLAB/Expressions": "./src/MATLAB/Expressions/index.ts",
    "./Excel/Expressions": "./src/Excel/Expressions/index.ts",
    "./LaTeX/Expressions": "./src/LaTeX/Expressions/index.ts",
    "./ISOIEC11404/Expressions": "./src/ISOIEC11404/Expressions/index.ts",
    "./IEEE754/Expressions": "./src/IEEE754/Expressions/index.ts",
    "./IEEE1164/Expressions": "./src/IEEE1164/Expressions/index.ts",
    "./Unicode/Expressions": "./src/Unicode/Expressions/index.ts",
    "./Translators": "./src/Translators/index.ts",
    "./Framework/*": "./src/Framework/*.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "python3 ../../mbse-basis/scripts/polyrepo.py check && npm --prefix ../../mbse-schemas/typescript5 install --no-audit --no-fund",
    "typecheck": "tsc --noEmit",
    "test": "tsx tests/run-notebooks.ts --typecheck",
    "conformance": "tsx src/Conformance/write.ts",
    "coverage": "c8 --check-coverage --100 tsx tests/run-notebooks.ts --typecheck"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "c8": "^11.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@mbse/schemas": "file:../../mbse-schemas/typescript5"
  }
}
