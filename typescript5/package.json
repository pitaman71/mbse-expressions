{
  "name": "@mbse/expressions",
  "version": "0.2.4",
  "description": "Rules, predicates and constraints as language-neutral data: validated, evaluated, stored as JSON/YAML, and translated to and from Python, MATLAB and Excel (TypeScript implementation)",
  "keywords": [
    "expressions",
    "rules",
    "constraints",
    "predicates",
    "mbse",
    "sysml",
    "interface",
    "translation",
    "excel",
    "matlab"
  ],
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./Framework": "./src/Framework/index.ts",
    "./Dialects/*": "./src/Dialects/*/index.ts",
    "./Translators": "./src/Translators/index.ts",
    "./Framework/*": "./src/Framework/*.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "python3 ../scripts/siblings.py check && npm --prefix ../../mbse-schemas/typescript5 install --no-audit --no-fund",
    "typecheck": "tsc --noEmit",
    "test": "tsx tests/run-notebooks.ts --typecheck",
    "conformance": "tsx src/Conformance/write.ts",
    "coverage": "c8 --check-coverage --100 tsx tests/run-notebooks.ts --typecheck"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "c8": "^11.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@mbse/schemas": "file:../../mbse-schemas/typescript5"
  }
}
